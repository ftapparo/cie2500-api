    "/v3/api/cie/commands/{action}": {
      "post": {
        "tags": ["CIE — Comandos"],
        "summary": "Comando de botão da central",
        "description": "Executa um comando de botão. `alarm-general` e `restart` exigem `{ \"confirm\": true }` no corpo.",
        "operationId": "executeCieCommand",
        "parameters": [
          {
            "name": "action",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["silence", "release", "release-bip", "release-siren", "restart", "brigade-siren", "alarm-general", "delay-siren", "silence-bip", "silence-siren"]
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "confirm": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Comando executado.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/HealthResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "action": {
                              "type": "string",
                              "example": "silence-bip"
                            },
                            "payload": {
                              "type": "object",
                              "additionalProperties": {
                                "type": "integer"
                              }
                            },
                            "response": {
                              "description": "Resposta bruta da central."
                            },
                            "snapshot": {
                              "$ref": "#/components/schemas/CieStateSnapshot"
                            }
                          },
                          "required": ["action", "response", "snapshot"]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "description": "Comando rejeitado pela central.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Falha ao comunicar com a central.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
