    "/v3/api/cie/logs": {
      "get": {
        "tags": ["CIE"],
        "summary": "Lista de logs da central",
        "description": "Retorna eventos registrados pela central, com paginação por cursor e filtro opcional por tipo.",
        "operationId": "listCieLogs",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Filtra por tipo de evento. Omitido retorna todos os tipos.",
            "schema": { "type": "string", "enum": ["alarme", "falha", "supervisao", "operacao", "bloqueio"] }
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "description": "Filtra pela natureza do evento (ex.: só ativações).",
            "schema": { "type": "string", "enum": ["ativacao", "restauracao", "estado", "informativo"] }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Quantidade máxima de itens retornados (1 a 200).",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Cursor de paginação retornado por uma chamada anterior (campo nextCursor).",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de logs.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/HealthResponse" },
                    { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/LogsListData" } } }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
