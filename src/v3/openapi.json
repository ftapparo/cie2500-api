{
  "openapi": "3.0.3",
  "info": {
    "title": "Nova CIE — v3",
    "version": "3.0.0",
    "description": "API v3 - Central de Incêndio Nova Residence\n\nEventos em tempo real: WebSocket em `/v3/ws` (mesma autenticação das rotas). Mensagens `{ event, timestamp, data, meta: { version: \"v3\" } }` com os eventos `connection.established`, `connection.status.changed`, `cie.status.updated`, `cie.alarm.triggered`, `cie.failure.triggered` e `cie.log.received`."
  },
  "tags": [
    {
      "name": "Health",
      "description": "Disponibilidade do serviço e status da conexão com a central."
    },
    {
      "name": "CIE",
      "description": "Consulta de estado, painel, alarmes, logs e contadores da central de incêndio."
    },
    { "name": "CIE — Comandos", "description": "Comandos que acionam a central de incêndio. Atuam sobre o equipamento físico." }
  ],
  "security": [{ "ApiToken": [] }],
  "components": {
    "securitySchemes": {
      "ApiToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token de acesso à API."
      }
    },
    "schemas": {
      "ResponseMeta": {
        "type": "object",
        "description": "Metadado transversal presente em toda resposta, dentro ou fora do envelope de sucesso/erro.",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Instante em que a resposta foi gerada.",
            "example": "2026-09-28T03:44:40.342Z"
          },
          "requestId": {
            "type": "string",
            "nullable": true,
            "description": "Identificador da requisição, para correlação em logs e suporte.",
            "example": "req-1"
          },
          "version": {
            "type": "string",
            "enum": ["v3"],
            "description": "Versão da API que gerou a resposta."
          },
          "pagination": {
            "type": "object",
            "description": "Presente somente em endpoints que retornam uma coleção paginada.",
            "properties": {
              "limit": { "type": "integer", "minimum": 1, "example": 25 },
              "offset": { "type": "integer", "minimum": 0, "example": 0 },
              "total": { "type": "integer", "minimum": 0, "example": 137 }
            },
            "required": ["limit", "offset", "total"]
          }
        },
        "required": ["timestamp", "requestId", "version"]
      },
      "ProblemDetails": {
        "type": "object",
        "description": "Estrutura padrão de erro da API, com tipo, título, status HTTP e detalhe da ocorrência.",
        "properties": {
          "type": {
            "type": "string",
            "description": "URN fixo identificando o tipo do erro (não é uma URL navegável).",
            "example": "urn:nova-cie:validation-error"
          },
          "title": {
            "type": "string",
            "description": "Resumo legível do tipo de erro.",
            "example": "Dados de entrada inválidos"
          },
          "status": {
            "type": "integer",
            "description": "Código HTTP correspondente, redundante com o status da resposta.",
            "example": 400
          },
          "detail": {
            "type": "string",
            "nullable": true,
            "description": "Explicação específica desta ocorrência do erro.",
            "example": "Um ou mais campos da requisição são inválidos."
          },
          "instance": {
            "type": "string",
            "nullable": true,
            "description": "Path da requisição que originou o erro.",
            "example": "/v3/api/health"
          },
          "validationErrors": {
            "type": "array",
            "description": "Presente somente quando type = validation-error.",
            "items": {
              "type": "object",
              "properties": {
                "path": { "type": "string", "example": "/name" },
                "message": { "type": "string", "example": "Too small: expected string to have >=3 characters" }
              },
              "required": ["path", "message"]
            }
          }
        },
        "required": ["type", "title", "status", "detail", "instance"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "enum": [false] },
          "error": { "$ref": "#/components/schemas/ProblemDetails" },
          "meta": { "$ref": "#/components/schemas/ResponseMeta" }
        },
        "required": ["success", "error", "meta"]
      },
      "HealthData": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["API Funcionando!"],
            "example": "API Funcionando!"
          },
          "service": {
            "type": "string",
            "enum": ["CIE2500"],
            "example": "CIE2500"
          },
          "health": {
            "type": "string",
            "enum": ["OK", "DEGRADED"],
            "description": "OK quando conectado à central; DEGRADED caso contrário.",
            "example": "OK"
          },
          "connected": {
            "type": "boolean",
            "description": "Estado atual da conexão TCP com a central.",
            "example": true
          },
          "reconnecting": {
            "type": "boolean",
            "description": "Indica se uma tentativa de reconexão está em andamento.",
            "example": false
          },
          "lastUpdated": {
            "type": "integer",
            "nullable": true,
            "description": "Timestamp Unix (ms) da última atualização de estado recebida da central.",
            "example": 1758000000000
          },
          "lastError": {
            "type": "string",
            "nullable": true,
            "description": "Última mensagem de erro de conexão registrada, se houver.",
            "example": null
          }
        },
        "required": ["status", "service", "health", "connected", "reconnecting", "lastUpdated", "lastError"]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "enum": [true] },
          "data": { "$ref": "#/components/schemas/HealthData" },
          "meta": { "$ref": "#/components/schemas/ResponseMeta" }
        },
        "required": ["success", "data", "meta"]
      },
      "NomeModelo": {
        "type": "object",
        "properties": {
          "endereco": { "type": "integer" },
          "nome": { "type": "string" },
          "modelo": { "type": "string" }
        },
        "required": ["endereco", "nome", "modelo"]
      },
      "DataHora": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "integer", "description": "Milissegundos desde 1970." },
          "utc": { "type": "string", "format": "date-time" },
          "local": { "type": "string", "description": "Data/hora amigável no fuso local." }
        },
        "required": ["timestamp", "utc", "local"]
      },
      "StatusCounters": {
        "type": "object",
        "properties": {
          "alarme": { "type": "integer" },
          "falha": { "type": "integer" },
          "supervisao": { "type": "integer" },
          "bloqueio": { "type": "integer" },
          "regrasTemporizando": { "type": "integer" }
        },
        "required": ["alarme", "falha", "supervisao", "bloqueio", "regrasTemporizando"]
      },
      "CieStateSnapshot": {
        "type": "object",
        "description": "Estado bruto mantido internamente a partir do último polling da central.",
        "properties": {
          "connected": { "type": "boolean" },
          "restartingUntil": { "type": "integer", "nullable": true },
          "nomeModelo": { "allOf": [{ "$ref": "#/components/schemas/NomeModelo" }], "nullable": true },
          "mac": { "type": "object", "nullable": true, "properties": { "mac": { "type": "string" } } },
          "info": { "type": "object", "nullable": true, "additionalProperties": { "type": "integer" } },
          "dataHora": { "allOf": [{ "$ref": "#/components/schemas/DataHora" }], "nullable": true },
          "status": {
            "type": "object",
            "nullable": true,
            "properties": {
              "status": { "$ref": "#/components/schemas/StatusCounters" },
              "leds": { "type": "object", "additionalProperties": { "type": "boolean" } }
            }
          },
          "lastUpdated": { "type": "integer", "nullable": true },
          "lastError": { "type": "string", "nullable": true },
          "reconnecting": { "type": "boolean" },
          "reconnectAttempt": { "type": "integer" }
        },
        "required": ["connected", "restartingUntil", "nomeModelo", "mac", "info", "dataHora", "status", "lastUpdated", "lastError", "reconnecting", "reconnectAttempt"]
      },
      "PanelData": {
        "type": "object",
        "description": "Visão consolidada do estado da central para exibição em painel/app.",
        "properties": {
          "online": { "type": "boolean" },
          "connected": { "type": "boolean" },
          "restarting": { "type": "boolean" },
          "restartingUntil": { "type": "integer", "nullable": true },
          "reconnecting": { "type": "boolean" },
          "reconnectAttempt": { "type": "integer" },
          "lastError": { "type": "string", "nullable": true },
          "lastUpdated": { "type": "integer", "nullable": true },
          "central": {
            "type": "object",
            "properties": {
              "ip": { "type": "string", "nullable": true },
              "endereco": { "type": "integer" },
              "nome": { "type": "string", "nullable": true },
              "modelo": { "type": "string", "nullable": true },
              "mac": { "type": "string", "nullable": true }
            },
            "required": ["ip", "endereco", "nome", "modelo", "mac"]
          },
          "dataHora": { "allOf": [{ "$ref": "#/components/schemas/DataHora" }], "nullable": true },
          "counters": { "allOf": [{ "$ref": "#/components/schemas/StatusCounters" }], "nullable": true },
          "leds": { "type": "object", "nullable": true, "additionalProperties": { "type": "boolean" } },
          "latestFailureEvent": { "allOf": [{ "$ref": "#/components/schemas/NormalizedCieLog" }], "nullable": true, "description": "Última falha real do histórico (event.kind = ativacao); restaurações não entram." },
          "latestAlarmEvent": { "allOf": [{ "$ref": "#/components/schemas/NormalizedCieLog" }], "nullable": true, "description": "Último alarme de incêndio do histórico (event.kind = ativacao)." },
          "situation": { "$ref": "#/components/schemas/PanelSituation" }
        },
        "required": ["online", "connected", "restarting", "restartingUntil", "reconnecting", "reconnectAttempt", "lastError", "lastUpdated", "central", "dataHora", "counters", "leds", "latestFailureEvent", "latestAlarmEvent", "situation"]
      },
      "PanelSituation": {
        "type": "object",
        "description": "Situação geral da central pronta para exibição. Prioridade: reiniciando > offline > alarme > falha > supervisão > bloqueio > normal.",
        "properties": {
          "state": { "type": "string", "enum": ["offline", "reiniciando", "alarme", "falha", "supervisao", "bloqueio", "normal"] },
          "label": { "type": "string", "example": "Sistema em falha" },
          "severity": { "$ref": "#/components/schemas/Severity" },
          "silenced": { "type": "boolean", "description": "Central ou sirene silenciada (LEDs do painel)." }
        },
        "required": ["state", "label", "severity", "silenced"]
      },
      "Severity": {
        "type": "string",
        "enum": ["critical", "warning", "info", "ok"],
        "description": "critical = incêndio/sem comunicação; warning = falha, supervisão ou ação relevante; info = registro; ok = normal/restaurado."
      },
      "EventInfo": {
        "type": "object",
        "description": "Evento já interpretado pela tabela da central (categoria + código). O cliente não deve interpretar eventType por conta própria.",
        "properties": {
          "category": { "type": "string", "enum": ["alarme", "falha", "supervisao", "operacao", "bloqueio"] },
          "code": { "type": "integer", "nullable": true, "example": 7 },
          "label": { "type": "string", "example": "Disp. em Falha" },
          "kind": { "type": "string", "enum": ["ativacao", "restauracao", "estado", "informativo"], "description": "ativacao = algo começou (incêndio, falha nova); restauracao = voltou ao normal; estado = resumo do sistema; informativo = registro sem ação." },
          "severity": { "$ref": "#/components/schemas/Severity" }
        },
        "required": ["category", "code", "label", "kind", "severity"]
      },
      "LogDisplay": {
        "type": "object",
        "description": "Cada dado do evento em um campo próprio, já interpretado. O cliente só escolhe o layout; não junta nem interpreta textos.",
        "properties": {
          "title": { "type": "string", "example": "Alarme" },
          "device": { "type": "string", "nullable": true, "example": "Sensor de Fumaça", "description": "Tipo do dispositivo." },
          "deviceName": { "type": "string", "nullable": true, "example": "16 ANDAR B T-B", "description": "Nome cadastrado na central (em operações, o nome da regra)." },
          "place": { "allOf": [{ "$ref": "#/components/schemas/Place" }], "nullable": true },
          "loop": { "type": "integer", "nullable": true, "example": 1 },
          "address": { "type": "integer", "nullable": true, "example": 100 },
          "zone": { "type": "integer", "nullable": true, "example": 4 },
          "zoneName": { "type": "string", "nullable": true, "example": "TORRE B" }
        },
        "required": ["title", "device", "deviceName", "place", "loop", "address", "zone", "zoneName"]
      },
      "Place": {
        "type": "object",
        "description": "Local interpretado do nome do dispositivo pela convenção do condomínio: \"16 ANDAR B T-B\" = torre B, 16º andar, posição B no andar; \"TERREO T-A\" = térreo da torre A; \"PRESSURIZA T-C\" = pressurização da torre C. null quando o nome não segue a convenção (ex.: \"ELEVADOR 1\").",
        "properties": {
          "tower": { "type": "string", "nullable": true, "example": "B" },
          "towerLabel": { "type": "string", "nullable": true, "example": "Torre B" },
          "floor": { "type": "integer", "nullable": true, "example": 16, "description": "0 = térreo." },
          "floorLabel": { "type": "string", "nullable": true, "example": "16º andar" },
          "position": { "type": "string", "nullable": true, "example": "B", "description": "Posição dentro do andar (A, B ou C)." },
          "positionLabel": { "type": "string", "nullable": true, "example": "Posição B" },
          "area": { "type": "string", "nullable": true, "example": "Pressurização" }
        },
        "required": ["tower", "towerLabel", "floor", "floorLabel", "position", "positionLabel", "area"]
      },
      "ActiveEventsData": {
        "type": "object",
        "properties": {
          "counters": { "$ref": "#/components/schemas/ActiveCounters" },
          "situation": { "$ref": "#/components/schemas/PanelSituation" },
          "events": {
            "type": "object",
            "description": "Eventos ativos agora na central, por tipo (só o tipo pedido quando há filtro). `bloqueio` vem sempre vazio: a central não fornece essa lista — use `counters.bloqueio` e `/cie/counters/blocks`.",
            "properties": {
              "alarme": { "type": "array", "items": { "$ref": "#/components/schemas/NormalizedCieLog" } },
              "falha": { "type": "array", "items": { "$ref": "#/components/schemas/NormalizedCieLog" } },
              "supervisao": { "type": "array", "items": { "$ref": "#/components/schemas/NormalizedCieLog" } },
              "bloqueio": { "type": "array", "items": { "$ref": "#/components/schemas/NormalizedCieLog" } }
            }
          }
        },
        "required": ["counters", "situation", "events"]
      },
      "ActiveCounters": {
        "type": "object",
        "properties": {
          "alarme": { "type": "integer" },
          "falha": { "type": "integer" },
          "supervisao": { "type": "integer" },
          "bloqueio": { "type": "integer" }
        },
        "required": ["alarme", "falha", "supervisao", "bloqueio"]
      },
      "DeviceClassification": {
        "type": "object",
        "properties": {
          "typeCode": { "type": "integer", "nullable": true },
          "subtypeCode": { "type": "integer", "nullable": true },
          "typeLabel": { "type": "string", "nullable": true },
          "subtypeLabel": { "type": "string", "nullable": true },
          "resolvedLabel": { "type": "string", "nullable": true },
          "source": { "type": "string", "enum": ["codes", "name", "none"] }
        },
        "required": ["typeCode", "subtypeCode", "typeLabel", "subtypeLabel", "resolvedLabel", "source"]
      },
      "NormalizedCieLog": {
        "type": "object",
        "properties": {
          "key": { "type": "string" },
          "type": { "type": "string", "enum": ["alarme", "falha", "supervisao", "operacao", "bloqueio"] },
          "id": { "type": "integer" },
          "zone": { "type": "integer", "nullable": true },
          "address": { "type": "integer", "nullable": true },
          "loop": { "type": "integer", "nullable": true },
          "deviceName": { "type": "string", "nullable": true },
          "zoneName": { "type": "string", "nullable": true },
          "deviceTypeCode": { "type": "integer", "nullable": true },
          "deviceTypeLabel": { "type": "string", "nullable": true },
          "deviceClassification": { "allOf": [{ "$ref": "#/components/schemas/DeviceClassification" }], "nullable": true },
          "eventType": { "type": "integer", "nullable": true, "description": "Código bruto da central. Use `event` para exibir." },
          "blocked": { "type": "boolean", "nullable": true },
          "occurredAt": { "type": "string", "format": "date-time" },
          "createdAt": { "type": "integer" },
          "source": { "type": "string", "enum": ["historico", "ativo"], "description": "historico = registro do log da central; ativo = evento ativo agora." },
          "event": { "$ref": "#/components/schemas/EventInfo" },
          "display": { "$ref": "#/components/schemas/LogDisplay" },
          "number": { "type": "integer", "nullable": true, "description": "Posição na central (no histórico, 1 é o mais recente)." },
          "firstEvent": { "type": "boolean", "nullable": true },
          "origin": { "type": "integer", "nullable": true, "description": "Central de origem na interligação." },
          "repeater": { "type": "integer", "nullable": true },
          "historyTotal": { "type": "integer", "nullable": true, "description": "Total de registros daquele tipo no histórico da central." }
        },
        "required": ["key", "type", "id", "zone", "address", "loop", "deviceName", "zoneName", "deviceTypeCode", "deviceTypeLabel", "deviceClassification", "eventType", "blocked", "occurredAt", "createdAt", "source", "event", "display", "number", "firstEvent", "origin", "repeater", "historyTotal"]
      },
      "AlarmActiveSnapshot": {
        "type": "object",
        "properties": {
          "isTriggered": { "type": "boolean" },
          "counters": { "$ref": "#/components/schemas/ActiveCounters" },
          "latestAlarmLogs": { "type": "array", "description": "Últimos alarmes do histórico (não necessariamente ativos).", "items": { "$ref": "#/components/schemas/NormalizedCieLog" } },
          "activeAlarms": { "type": "array", "description": "Alarmes ativos agora na central.", "items": { "$ref": "#/components/schemas/NormalizedCieLog" } },
          "situation": { "$ref": "#/components/schemas/PanelSituation" }
        },
        "required": ["isTriggered", "counters", "latestAlarmLogs", "activeAlarms", "situation"]
      },
      "LogsListData": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "example": "alarme" },
          "limit": { "type": "integer", "example": 50 },
          "cursor": { "type": "string", "nullable": true },
          "nextCursor": { "type": "string", "nullable": true },
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/NormalizedCieLog" } }
        },
        "required": ["type", "limit", "cursor", "nextCursor", "items"]
      },
      "BlockCounters": {
        "type": "object",
        "description": "Contadores de dispositivos configurados para bloqueio, por tipo e laço.",
        "properties": {
          "dispositivo": { "type": "integer" },
          "sirene": { "type": "integer" },
          "saida": { "type": "integer" },
          "atuador": { "type": "integer" },
          "regra": { "type": "integer" },
          "zona": { "type": "integer" },
          "laco": { "type": "integer" },
          "dispositivoLaco0": { "type": "integer" },
          "dispositivoLaco1": { "type": "integer" },
          "dispositivoLaco2": { "type": "integer" },
          "saidaLaco0": { "type": "integer" },
          "saidaLaco1": { "type": "integer" },
          "saidaLaco2": { "type": "integer" },
          "sireneLaco0": { "type": "integer" },
          "sireneLaco1": { "type": "integer" },
          "sireneLaco2": { "type": "integer" },
          "atuadorLaco0": { "type": "integer" },
          "atuadorLaco1": { "type": "integer" },
          "atuadorLaco2": { "type": "integer" }
        }
      },
      "OutputCounters": {
        "type": "object",
        "description": "Contadores de saídas configuradas, por tipo e laço.",
        "properties": {
          "saidaLaco0": { "type": "integer" },
          "saidaLaco1": { "type": "integer" },
          "saidaLaco2": { "type": "integer" },
          "sireneLaco0": { "type": "integer" },
          "sireneLaco1": { "type": "integer" },
          "sireneLaco2": { "type": "integer" },
          "atuadorLaco0": { "type": "integer" },
          "atuadorLaco1": { "type": "integer" },
          "atuadorLaco2": { "type": "integer" },
          "saida": { "type": "integer" },
          "sirene": { "type": "integer" },
          "atuador": { "type": "integer" }
        }
      }
    },
    "responses": {
      "NotFound": {
        "description": "Rota inexistente.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "success": false,
              "error": {
                "type": "urn:nova-cie:not-found",
                "title": "Recurso não encontrado",
                "status": 404,
                "detail": "Rota GET /v3/api/rota-que-nao-existe não existe.",
                "instance": "/v3/api/rota-que-nao-existe"
              },
              "meta": {
                "timestamp": "2026-09-28T03:24:14.989Z",
                "requestId": "req-2",
                "version": "v3"
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Não autorizado.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "success": false,
              "error": {
                "type": "urn:nova-cie:unauthorized",
                "title": "Autenticação necessária",
                "status": 401,
                "detail": "Não autorizado.",
                "instance": "/v3/api/cie/status"
              },
              "meta": {
                "timestamp": "2026-09-28T03:24:14.989Z",
                "requestId": "req-3",
                "version": "v3"
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/v3/api/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Healthcheck do serviço",
        "description": "Verifica disponibilidade da camada HTTP e o estado da conexão com a central de incêndio. Retorna 503 quando não conectado.",
        "operationId": "getHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "Serviço conectado à central.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" },
                "example": {
                  "success": true,
                  "data": { "status": "API Funcionando!", "service": "CIE2500", "health": "OK", "connected": true, "reconnecting": false, "lastUpdated": 1758000000000, "lastError": null },
                  "meta": {
                    "timestamp": "2026-09-28T03:44:40.342Z",
                    "requestId": "req-1",
                    "version": "v3"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Serviço não conectado à central.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" },
                "example": {
                  "success": true,
