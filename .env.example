PORT=4021

# v3 (Fastify + Zod) — roda lado a lado da v2, porta interna propria
PORT_V3=3031
SWAGGER_V3_ENABLED=true

# Token de servico compartilhado entre a nova-api e este projeto. So a
# nova-api (rede interna) deve conhecer este valor — gerar com algo como
# `openssl rand -hex 32`. Sem ele configurado, TODA rota da v3 (exceto
# /v3/api/health e /v3/api/healthcheck) recusa a chamada.
CIE_SERVICE_TOKEN=
CIE_WS_V3_MAX_CLIENTS=5

CIE_IP=192.168.0.4
CIE_PASSWORD=444444
CIE_ENDERECO=0

CIE_POLL_MS=4000
CIE_REQUEST_TIMEOUT_MS=10000
CIE_LOG_BACKFILL_LIMIT=50
CIE_LOG_RING_SIZE=1000
CIE_DISCOVERY_ENABLED=false
CIE_RESTART_WATCHDOG_ENABLED=false

# Mapeamento oficial Intelbras (ProgramadorCIE):
# 0=Sirene Brigada, 1=Alarme Geral, 2=Adiar Regra, 3=Reiniciar,
# 4=Silenciar Sirene, 5=Silenciar Central (BIP).
# Release de BIP/Sirene e toggle no mesmo botao de silenciar.
CIE_CMD_SILENCE_BUTTON=5
CIE_CMD_SILENCE_PARAM=0

CIE_CMD_RELEASE_BUTTON=5
CIE_CMD_RELEASE_PARAM=1

# Opcional: releases dedicados (toggle -> mesmo botao de silenciar)
CIE_CMD_RELEASE_BIP_BUTTON=5
CIE_CMD_RELEASE_BIP_PARAM=1
CIE_CMD_RELEASE_SIREN_BUTTON=4
CIE_CMD_RELEASE_SIREN_PARAM=1

CIE_CMD_RESTART_BUTTON=3
CIE_CMD_RESTART_PARAM=0

CIE_CMD_BRIGADE_SIREN_BUTTON=0
CIE_CMD_BRIGADE_SIREN_PARAM=0

CIE_CMD_ALARM_GENERAL_BUTTON=1
CIE_CMD_ALARM_GENERAL_PARAM=0

CIE_CMD_DELAY_SIREN_BUTTON=2
CIE_CMD_DELAY_SIREN_PARAM=250

CIE_CMD_SILENCE_BIP_BUTTON=5
CIE_CMD_SILENCE_BIP_PARAM=0

CIE_CMD_SILENCE_SIREN_BUTTON=4
CIE_CMD_SILENCE_SIREN_PARAM=0

# Relay de push para API principal.
# Usa o nome do serviço Docker (container_name da API), resolvido pela rede
# interna nova-network — mais robusto que o IP fixo do host, que quebraria
# silenciosamente se o servidor um dia mudasse de endereço.
MAIN_API_BASE_URL=http://nova-api:3030
# Opcional: com valor, o push vai para a v3 (/v3/api/push/send), autenticado
# por API_SERVICE_TOKEN (mesmo valor configurado na stack nova-api). Vazio =
# segue na v2. MAIN_API_BASE_URL continua obrigatória para ligar o relay.
MAIN_API_V3_BASE_URL=
API_SERVICE_TOKEN=
MAIN_API_PUSH_TIMEOUT_MS=3000
MAIN_API_PUSH_RETRIES=3
CIE_PUSH_FIRE_ALARM_COOLDOWN_MS=60000
CIE_PUSH_FAILURE_ALARM_COOLDOWN_MS=60000
